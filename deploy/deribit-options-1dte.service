# 1DTE option-grid collector (next daily expiry).
# Install on the VM:
#   sudo cp deploy/deribit-options-1dte.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now deribit-options-1dte
[Unit]
Description=Deribit 1DTE option-grid collector (next daily expiry)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=i_garpet
WorkingDirectory=/home/i_garpet/deribit-market-data
ExecStart=/home/i_garpet/deribit-market-data/.venv/bin/python -u src/option_1dte_collector.py
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=60
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
